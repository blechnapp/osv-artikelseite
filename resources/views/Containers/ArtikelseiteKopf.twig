<style>
{% if namen %}
/* Ausführungen als Raster mit Namen darunter (Name kommt per Skript aus dem alt-Text des Bildes) */
.widget-attribute .v-s-boxes.images { display: grid !important; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
.widget-attribute .v-s-boxes.images .v-s-box { display: flex !important; flex-direction: column; align-items: center; width: auto !important; height: auto !important; margin: 0 !important; padding: 5px 4px 6px !important; border-radius: 6px; }
.widget-attribute .v-s-boxes.images .v-s-box img { width: 100%; aspect-ratio: 1 / 1; object-fit: contain; padding: 0 !important; }
.widget-attribute .osva-vname { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.5em; margin-top: 4px; font-size: 11.5px; line-height: 1.25; text-align: center; color: #4a4a4a; overflow-wrap: anywhere; hyphens: auto; }
.widget-attribute .v-s-box.active .osva-vname { color: #0c2a5e; font-weight: 600; }
@media (max-width: 575.98px) {
  .widget-attribute .v-s-boxes.images { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
  .widget-attribute .osva-vname { font-size: 10.5px; }
}
{% endif %}
{% if thumbs %}
/* Vorschaubilder links senkrecht neben dem Hauptbild, nur Rechner */
@media (min-width: 992px) {
  .widget-item-image { position: relative; padding-left: 104px; }
  .widget-item-image #thumb-carousel { position: absolute; left: 0; top: 0; width: 92px; max-height: 100%; overflow-y: auto; scrollbar-width: thin; }
  .widget-item-image #thumb-carousel .owl-stage-outer { height: auto !important; overflow: visible; }
  .widget-item-image #thumb-carousel .owl-stage { transform: none !important; width: auto !important; display: flex; flex-direction: column; gap: 8px; }
  .widget-item-image #thumb-carousel .owl-item { width: 92px !important; margin: 0 !important; }
  .widget-item-image #thumb-carousel .owl-nav { display: none; }
  .widget-item-image #thumb-carousel .image-container { padding: 4px; border: 1.5px solid #e5dfd6; border-radius: 6px; }
  .widget-item-image #thumb-carousel .owl-item .active .image-container, .widget-item-image #thumb-carousel picture.active { outline: 2px solid #0c2a5e; outline-offset: -2px; border-radius: 6px; }
}
{% endif %}
{% if cs %}
/* Zubehör: kompakte Liste unter dem Warenkorb-Knopf */
.osva-zb { margin: 6px 0 18px; border: 1px solid #e5dfd6; border-radius: 8px; overflow: hidden; background: #fff; }
.osva-zb-kopf { font-weight: 600; font-size: 16px; color: #0c2a5e; padding: 9px 14px; background: #faf7f2; border-bottom: 1px solid #e5dfd6; }
.osva-zb-zeile { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto 44px; gap: 12px; align-items: center; padding: 8px 10px 8px 12px; border-bottom: 1px solid #f2ece2; }
.osva-zb-zeile:last-child { border-bottom: 0; }
.osva-zb-zeile:hover { background: #fbf7f0; }
.osva-zb-zeile > a.osva-zb-bild img { width: 64px; height: 64px; object-fit: contain; display: block; }
.osva-zb-txt { min-width: 0; line-height: 1.3; text-decoration: none !important; color: #1c1c1c !important; }
.osva-zb-txt b { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-weight: 500; font-size: 14px; }
.osva-zb-txt em { display: block; font-style: normal; font-size: 12.5px; color: #6b6b6b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.osva-zb-preis { font-weight: 700; font-size: 15px; color: #0c2a5e; white-space: nowrap; text-align: right; }
.osva-zb-preis del { display: block; font-weight: 400; font-size: 11.5px; color: #8a8a8a; }
.osva-korb { width: 44px; height: 44px; position: relative; }
.osva-korb .add-to-basket-lg-container { position: static !important; display: flex !important; align-items: center; justify-content: center; width: 44px; height: 44px; border: 1.5px solid #0c2a5e; border-radius: 6px; background: #fff; color: #0c2a5e; cursor: pointer; }
.osva-korb .add-to-basket-lg-container:hover { background: #0c2a5e; color: #fff; }
.osva-korb .add-to-basket-lg-container i { margin: 0 !important; position: static !important; }
.osva-korb > div > *:not(.add-to-basket-lg-container) { display: none !important; }
@media (max-width: 575.98px) {
  .osva-zb-zeile { grid-template-columns: 52px minmax(0, 1fr) auto 40px; gap: 10px; padding: 7px 8px 7px 10px; }
  .osva-zb-zeile > a.osva-zb-bild img { width: 52px; height: 52px; }
  .osva-korb, .osva-korb .add-to-basket-lg-container { width: 40px; height: 40px; }
}
/* Ceres zeigt den Knopf im Kachel-Baustein nur am Rechner (d-lg-block); in der Zubehörliste immer */
.osva-korb .add-to-basket-lg-container.d-none { display: flex !important; }

/* Empfehlungen: 4 Kacheln nebeneinander, Handy Wischzeile */
.osva-empf { margin: 36px 0 28px; }
.osva-empf h2 { font-size: 26px; color: #0c2a5e; margin-bottom: 18px; }
.osva-reihe { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
.osva-k { position: relative; display: flex; flex-direction: column; background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 1px 3px rgba(12,42,94,.08), 0 4px 14px rgba(12,42,94,.06); text-decoration: none !important; color: #1c1c1c !important; transition: transform .18s, box-shadow .18s; }
.osva-k:hover { transform: translateY(-3px); box-shadow: 0 6px 22px rgba(12,42,94,.16); }
.osva-k-bild { aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center; padding: 14px; background: #fff; }
.osva-k-bild img { max-width: 100%; max-height: 100%; object-fit: contain; }
.osva-k-txt { padding: 12px 14px 14px; border-top: 1px solid #eee; display: flex; flex-direction: column; gap: 4px; flex: 1; }
.osva-k-name { font-size: 15px; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.7em; }
.osva-k-meta { font-size: 12.5px; color: #6b6b6b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-height: 1.4em; }
.osva-k-lief { font-size: 12px; color: #2e7d32; }
.osva-k-preis { margin-top: auto; padding-top: 6px; font-size: 18px; font-weight: 700; color: #0c2a5e; }
.osva-k-preis del { font-size: 13px; font-weight: 400; color: #8a8a8a; margin-left: 6px; }
.osva-marke { position: absolute; top: 10px; left: 10px; z-index: 2; background: #b08052; color: #fff; font-size: 11.5px; font-weight: 700; letter-spacing: .03em; padding: 4px 9px; border-radius: 3px; }
@media (max-width: 991.98px) { .osva-reihe { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } }
@media (max-width: 575.98px) {
  .osva-empf h2 { font-size: 22px; }
  .osva-reihe { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin: 0 -15px; padding: 2px 15px 8px; }
  .osva-reihe::-webkit-scrollbar { display: none; }
  .osva-reihe .osva-k { flex: 0 0 43%; scroll-snap-align: start; }
  .osva-k:hover { transform: none; }
  .osva-k-name { font-size: 14px; }
  .osva-k-txt { padding: 10px 10px 12px; }
  .osva-k-lief { font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .osva-k-preis { font-size: 16px; }
  .osva-marke { top: 6px; left: 6px; font-size: 10px; padding: 3px 6px; }
}
/* Ceres-Artikellisten der Artikelseite weichen, sobald eigene Werte da sind */
body.osva-eigen .widget-item-list { display: none !important; }
{% endif %}
{% if aufbau %}
/* ===== Aufbau wie im Entwurf (artikelseite_20261028/vorschau.html), nur auf der Artikelseite (.single) ===== */
/* Galerie: warmer Bildgrund, runde Ecken */
/* Die Produktfotos haben weißen Grund: deshalb weiß mit feinem Rahmen statt Verlauf (Verlauf zeigte Ränder, getestet 28.10.) */
.single .widget-item-image .single-carousel .owl-stage-outer { background: #fff; border: 1px solid #eee8de; border-radius: 12px; }

/* Mitlaufen der Kaufbox: macht Ceres per Skript (sticky-element). Dafür darf die Box keine Außenabstände haben,
   die beim Mitlaufen anders zählen als im Fluss (28.10.: 6 px margin-top ließen Ceres zwischen fest und normal springen). */
/* Kaufbox als Karte, Bausteine per Reihenfolge wie im Entwurf (kein Umbau im DOM) */
.single .widget-sticky > .widget-inner { display: flex; flex-direction: column; background: #fff; border: 1px solid #eef1f4; border-radius: 10px; padding: 24px 26px 22px; box-shadow: 0 10px 30px rgba(12,42,94,.09); }
.single .widget-sticky > .widget-inner > * { order: 5; }
.single .widget-sticky .producertag { order: 1; }
.single .widget-sticky .title-outer { order: 2; }
.single .widget-sticky .widget-tag { order: 3; }
.single .widget-sticky .widget-feedback-average { order: 4; }
.single .widget-sticky .widget-separator { display: none; }
.single .widget-sticky .widget-code:not(.vat) { order: 10; }
.single .widget-sticky .widget-item-price { order: 11; }
.single .widget-sticky .widget-graduate-price { order: 12; }
.single .widget-sticky .widget-availability { order: 13; }
.single .widget-sticky .av-date { order: 14; }
.single .widget-sticky .widget-energy-label { order: 15; }
.single .widget-sticky .widget-datasheet { order: 16; }
.single .widget-sticky .widget-attribute { order: 20; }
.single .widget-sticky .widget-order-property { order: 21; }
.single .widget-sticky .widget-item-bundle { order: 22; }
.single .widget-sticky .widget-item-availability-notification { order: 29; }
.single .widget-sticky .widget-add-to-basket { order: 30; }
.single .widget-sticky .osva-zb { order: 31; }
.single .widget-sticky .widget-add-to-wish-list { order: 32; }
.single .widget-sticky .paypal-installment-banner-graphical { order: 33; }
.single .widget-sticky .widget-warning { order: 40; }
.single .widget-sticky .articlenumber { order: 41; }
.single .widget-sticky .vat { order: 42; }

/* Marke, Titel, Ausführung in der Überschrift */
.single .widget-sticky .producertag p { font-size: 12.5px; letter-spacing: .16em; text-transform: uppercase; color: #b08052 !important; margin: 0 0 8px; }
.single .widget-sticky .producertag p * { color: #b08052 !important; }
.single .widget-sticky .title-outer h1 { color: #0c2a5e; font-size: clamp(24px, 2.4vw, 32px); line-height: 1.2; margin: 0 0 8px; }
.single .widget-sticky .title-outer h1 > span + span { display: block; color: #b08052; font-size: .82em; margin-top: 2px; }
.single .widget-sticky .widget-text:not(.producertag):not(.title-outer):not(.av-date):not(.articlenumber):not(.widget-warning) p { font-size: 14px; color: #6b6b6b; margin: 0 0 6px; }
.single .widget-sticky .widget-text:not(.producertag):not(.title-outer):not(.av-date):not(.articlenumber):not(.widget-warning) p strong { font-weight: 500; }
.single .widget-sticky .widget-feedback-average { margin: 2px 0 12px; }

/* Preis: groß, UVP und Grundpreis leise */
.single .widget-sticky .widget-item-price { border-top: 1px solid #e5dfd6; padding-top: 14px; margin-top: 4px; }
.single .widget-sticky .widget-item-price .has-crossprice, .single .widget-sticky .widget-item-price > div { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
.single .widget-sticky .widget-item-price .price { order: 1; font-size: 36px !important; font-weight: 700; color: #0c2a5e; line-height: 1.1; margin: 0; }
.single .widget-sticky .widget-item-price .crossprice { order: 2; }
.single .widget-sticky .widget-item-price .crossprice del { font-size: 16px; }
.single .widget-sticky .widget-item-price .base-price { order: 3; flex-basis: 100%; margin: 4px 0 0 !important; font-size: 13.5px; }
.single .widget-sticky .widget-code:not(.vat) { margin: 4px 0 2px; }

/* Lieferbarkeit als Zeile mit Punkt */
.single .widget-sticky .widget-availability { margin: 12px 0 14px; font-size: 15px; }
.single .widget-sticky .widget-availability .availability { background: none !important; padding: 0; font-size: 15px; font-weight: 500; color: #1c7a3e; white-space: normal; text-align: left; }
.single .widget-sticky .widget-availability .availability:before { content: ""; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: currentColor; margin-right: 8px; vertical-align: 2px; }
.single .widget-sticky .widget-availability .availability:not(.availability-1) { color: #b26a00; }
.single .widget-sticky .av-date h4 { font-size: 14px; margin: -8px 0 12px; }

/* Ausführungen: Kopfzeile wie im Entwurf */
.single .widget-sticky .widget-attribute { border-top: 1px solid #e5dfd6; padding-top: 14px; margin-bottom: 8px !important; }
.single .widget-sticky .widget-attribute [data-testing="attribute-name"] { font-weight: 700; color: #0c2a5e !important; }

/* Ausführungen: erst eine Reihe (Rechner 5, Handy 4), die gewählte bleibt immer sichtbar, Rest per Knopf */
.single .widget-sticky .widget-attribute .v-s-boxes { padding: 8px 0 4px !important; }
.single .widget-sticky .osva-v-zu .v-s-boxes.images .v-s-box:nth-of-type(n+6):not(.active) { display: none !important; }
/* gewählte Ausführung steht weiter hinten: eine weniger zeigen, damit sie in die erste Reihe rückt */
.single .widget-sticky .osva-v-zu.osva-v-hinten .v-s-boxes.images .v-s-box:nth-of-type(n+5):not(.active) { display: none !important; }
.single .widget-sticky .osva-v-mehr { order: 20; display: block; width: 100%; margin: 2px 0 14px; padding: 9px; border: 1.5px solid #e5dfd6; border-radius: 5px; background: #fff; font-weight: 600; font-size: 15px; color: #0c2a5e; cursor: pointer; }
.single .widget-sticky .osva-v-mehr:hover { border-color: #b08052; background: #faf7f2; }
/* leere Ceres-Bausteine ohne Abstand */
.single .widget-sticky .widget-item-bundle, .single .widget-sticky .widget-order-property, .single .widget-sticky .widget-graduate-price,
.single .widget-sticky .widget-energy-label, .single .widget-sticky .widget-datasheet, .single .widget-sticky .widget-item-availability-notification,
.single .widget-sticky .widget-tag { margin: 0 !important; }
.single .widget-sticky .widget-tag:empty { display: none; }
.single .widget-sticky .paypal-installment-banner-graphical { margin: 0 !important; }
/* Rechner: Bild läuft beim Scrollen neben der Kaufbox mit (wie im Entwurf) */
@media (min-width: 992px) { .single .widget-item-image { position: sticky; top: 20px; } }

/* Warenkorb: dunkelblauer Knopf, Menge daneben */
.single .widget-sticky .widget-add-to-basket { margin: 6px 0 12px !important; }
.single .widget-sticky .widget-add-to-basket .btn-primary { background: #0c2a5e !important; border-color: #0c2a5e !important; color: #fff !important; border-radius: 5px !important; min-height: 52px; font-size: 17px; font-weight: 600; }
.single .widget-sticky .widget-add-to-basket .btn-primary:hover { background: #04305e !important; }
.single .widget-sticky .widget-add-to-basket .qty-box { border-radius: 5px; overflow: hidden; }
.single .widget-sticky .widget-add-to-wish-list { margin: -4px 0 6px; }

/* Versandhinweis und Kleingedrucktes am Ende der Karte */
.single .widget-sticky .widget-warning > .widget-inner { background: none !important; border: 0 !important; padding: 0 !important; margin: 10px 0 6px; }
.single .widget-sticky .widget-warning h4 { font-size: 14.5px; font-weight: 400; color: #4a4a4a; margin: 0; }
.single .widget-sticky .widget-warning h4 span { color: #4a4a4a !important; }
.single .widget-sticky .articlenumber { margin: 4px 0 2px !important; font-size: 12.5px; }
.single .widget-sticky .articlenumber p { margin: 0; }
.single .widget-sticky .vat { font-size: 12px; margin-top: 6px; }

/* Abschnitte unter Bild und Kaufbox: volle Breite, Reiter werden Klappkarten */
.single .osva-ab-grid > .widget-inner:first-child { flex: 0 0 100% !important; max-width: 100% !important; }
.single .osva-ab-grid > .widget-inner:nth-child(2) { display: none !important; }
.single .osva-karten { margin-top: 28px !important; }
.single .osva-karten .nav-tabs { display: none !important; }
.single .osva-karten .tab-content > .tab-pane { display: block !important; opacity: 1 !important; background: #fff; border: 1px solid #e5dfd6; border-radius: 10px; margin-bottom: 14px; overflow: hidden; }
.single .osva-karten .tab-content > .tab-pane.osva-leer { display: none !important; }
.single .osva-karten .tab-pane > :not(.osva-ab-kopf) { padding: 0 26px 20px; margin: 0 !important; }
.single .osva-karten .tab-pane:not(.osva-offen) > :not(.osva-ab-kopf) { display: none !important; }
.single .osva-ab-kopf { display: block; width: 100%; text-align: left; background: none; border: 0; padding: 18px 52px 18px 26px; position: relative; font-size: 21px; font-weight: 600; color: #0c2a5e; cursor: pointer; }
.single .osva-ab-kopf:after { content: ""; position: absolute; right: 24px; top: 24px; width: 9px; height: 9px; border-right: 2px solid #b08052; border-bottom: 2px solid #b08052; transform: rotate(45deg); transition: .2s; }
.single .osva-offen > .osva-ab-kopf { border-bottom: 1px solid #e5dfd6; margin-bottom: 18px; }
.single .osva-offen > .osva-ab-kopf:after { transform: rotate(-135deg); top: 28px; }
.single .osva-karten .tab-pane h2 { font-size: 21px; color: #0c2a5e; margin: 0 0 12px; }
.single .osva-karten .tab-pane p { font-size: 16px; line-height: 1.7; color: #3c3c3c; }
.single .osva-karten .tab-pane p:empty { display: none; }
.single .osva-karten .tab-pane ul { list-style: none; padding-left: 0; margin: 14px 0; }
.single .osva-karten .tab-pane ul li { position: relative; padding-left: 22px; margin-bottom: 6px; font-size: 16px; line-height: 1.6; }
.single .osva-karten .tab-pane ul li:before { content: ""; position: absolute; left: 5px; top: 10px; width: 6px; height: 6px; border-radius: 50%; background: #b08052; }
.single .osva-karten .tab-pane table { max-width: 640px; }

/* Rechner wie im Entwurf: begrenzte Breite mit Rand, warmer Seitengrund, Abstand zwischen Bild und Kaufbox (Bildpfeile bleiben wie bei Ceres) */
@media (min-width: 992px) {
  #page-body:has(> .single.page-content) { background: #faf7f2; }
  .single.page-content { max-width: 1320px !important; margin-left: auto; margin-right: auto; padding-left: 24px !important; padding-right: 24px !important; padding-bottom: 40px; }
  .single .widget-item-image { padding-top: 6px; }
  .single .widget-item-image { margin-right: 26px; }
  .single div:has(> .widget-sticky) { padding-left: 26px; padding-top: 6px; }
  .single .widget-item-image .single-carousel .owl-stage-outer { box-shadow: 0 6px 24px rgba(60,40,20,.08); }
  .single .widget-item-image #thumb-carousel .image-container { background: #fff !important; }
  .single .osva-karten .tab-content > .tab-pane { box-shadow: 0 2px 10px rgba(60,40,20,.05); }
  .single .osva-empf { margin-top: 44px; }
}

@media (max-width: 991.98px) {
  .single .widget-sticky > .widget-inner { box-shadow: none; padding: 18px 16px 16px; }
  .single div:has(> .widget-sticky) { padding-top: 12px; }
  .single .osva-ab-kopf { font-size: 18px; padding: 15px 46px 15px 18px; }
  .single .osva-ab-kopf:after { right: 20px; top: 20px; }
  .single .osva-offen > .osva-ab-kopf:after { top: 24px; }
  .single .osva-karten .tab-pane > :not(.osva-ab-kopf) { padding: 0 18px 16px; }
}
@media (max-width: 575.98px) {
  /* Handy: Bild kleiner, Vorschaubilder als Wischzeile, damit Name und Preis früher kommen */
  /* Bildhöhe am Handy begrenzen. Das Shop-CSS (Ceres-Einstellungen) setzt .single-carousel .owl-item/a/img auf height: 70vh !important
     und .prop-1-1 auf padding-bottom: 70vh; das sind am Handy rund 590 px. Hier mit stärkerem Selektor überschrieben. */
  .single .widget-item-image .owl-carousel.single-carousel .owl-stage-outer .owl-item,
  .single .widget-item-image .owl-carousel.single-carousel .owl-stage-outer .owl-item .prop-1-1 > a { height: 300px !important; }
  /* schon vor dem Aufbau des Karussells 300 px, sonst rutscht die Kaufbox nach dem Aufbau 220 px hoch (CLS 0,08, gemessen 28.10.) */
  .single .widget-item-image .single-carousel { height: 300px !important; max-height: 300px; overflow: hidden; }
  .single .widget-item-image #thumb-carousel { height: 62px !important; overflow: hidden; }
  /* Ceres reserviert für den noch leeren Bildbereich per ::before 70vh (am Handy 591 px). Wir zeigen 300 + 7 + 62 = 369 px;
     Platzhalter genau darauf, sonst springt die Kaufbox beim Start von Vue 222 px hoch (CLS 0,084, gemessen 28.10.). */
  .single .widget-item-image:empty::before { height: 369px !important; padding: 0 !important; }
  .single .widget-item-image .owl-carousel.single-carousel .owl-stage-outer { height: auto !important; }
  .single .widget-item-image .owl-carousel.single-carousel .owl-stage-outer .owl-item .prop-1-1 { padding-bottom: 0 !important; height: 300px !important; }
  .single .widget-item-image .owl-carousel.single-carousel .owl-item .prop-1-1 > a { display: flex !important; align-items: center; justify-content: center; }
  .single .widget-item-image .owl-carousel.single-carousel .owl-item .prop-1-1 img { max-height: 280px !important; max-width: 100% !important; width: auto !important; height: auto !important; margin: 0 auto !important; object-fit: contain; }
  .single .widget-item-image #thumb-carousel .owl-stage-outer { height: auto !important; overflow-x: auto; scrollbar-width: none; }
  .single .widget-item-image #thumb-carousel .owl-stage-outer::-webkit-scrollbar { display: none; }
  .single .widget-item-image #thumb-carousel .owl-stage { transform: none !important; width: max-content !important; display: flex; gap: 8px; }
