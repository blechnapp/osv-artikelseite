<style>
{% if namen %}
/* Ausführungen als Raster mit Namen darunter (Name kommt per Skript aus dem alt-Text des Bildes) */
.widget-attribute .v-s-boxes.images { display: grid !important; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
.widget-attribute .v-s-boxes.images .v-s-box { display: flex !important; flex-direction: column; align-items: center; width: auto !important; height: auto !important; margin: 0 !important; padding: 5px 4px 6px !important; border-radius: 6px; }
.widget-attribute .v-s-boxes.images .v-s-box img { width: 100%; aspect-ratio: 1 / 1; object-fit: contain; padding: 0 !important; }
.widget-attribute .osva-vname { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.5em; margin-top: 4px; font-size: 11.5px; line-height: 1.25; text-align: center; color: #4a4a4a; overflow-wrap: anywhere; hyphens: auto; }
.widget-attribute .v-s-box.active .osva-vname { color: #0c2a5e; font-weight: 600; }
@media (max-width: 575.98px) {
  .widget-attribute .v-s-boxes.images { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
  .widget-attribute .osva-vname { font-size: 10.5px; }
}
{% endif %}
{% if thumbs %}
/* Vorschaubilder links senkrecht neben dem Hauptbild, nur Rechner */
@media (min-width: 992px) {
  .widget-item-image { position: relative; padding-left: 104px; }
  .widget-item-image #thumb-carousel { position: absolute; left: 0; top: 0; width: 92px; max-height: 100%; overflow-y: auto; scrollbar-width: thin; }
  .widget-item-image #thumb-carousel .owl-stage-outer { height: auto !important; overflow: visible; }
  .widget-item-image #thumb-carousel .owl-stage { transform: none !important; width: auto !important; display: flex; flex-direction: column; gap: 8px; }
  .widget-item-image #thumb-carousel .owl-item { width: 92px !important; margin: 0 !important; }
  .widget-item-image #thumb-carousel .owl-nav { display: none; }
  .widget-item-image #thumb-carousel .image-container { padding: 4px; border: 1.5px solid #e5dfd6; border-radius: 6px; }
  .widget-item-image #thumb-carousel .owl-item .active .image-container, .widget-item-image #thumb-carousel picture.active { outline: 2px solid #0c2a5e; outline-offset: -2px; border-radius: 6px; }
}
{% endif %}
{% if cs %}
/* Zubehör: kompakte Liste unter dem Warenkorb-Knopf */
.osva-zb { margin: 6px 0 18px; border: 1px solid #e5dfd6; border-radius: 8px; overflow: hidden; background: #fff; }
.osva-zb-kopf { font-weight: 600; font-size: 16px; color: #0c2a5e; padding: 9px 14px; background: #faf7f2; border-bottom: 1px solid #e5dfd6; }
.osva-zb-zeile { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto 44px; gap: 12px; align-items: center; padding: 8px 10px 8px 12px; border-bottom: 1px solid #f2ece2; }
.osva-zb-zeile:last-child { border-bottom: 0; }
.osva-zb-zeile:hover { background: #fbf7f0; }
.osva-zb-zeile > a.osva-zb-bild img { width: 64px; height: 64px; object-fit: contain; display: block; }
.osva-zb-txt { min-width: 0; line-height: 1.3; text-decoration: none !important; color: #1c1c1c !important; }
.osva-zb-txt b { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-weight: 500; font-size: 14px; }
.osva-zb-txt em { display: block; font-style: normal; font-size: 12.5px; color: #6b6b6b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.osva-zb-preis { font-weight: 700; font-size: 15px; color: #0c2a5e; white-space: nowrap; text-align: right; }
.osva-zb-preis del { display: block; font-weight: 400; font-size: 11.5px; color: #8a8a8a; }
.osva-korb { width: 44px; height: 44px; position: relative; }
.osva-korb .add-to-basket-lg-container { position: static !important; display: flex !important; align-items: center; justify-content: center; width: 44px; height: 44px; border: 1.5px solid #0c2a5e; border-radius: 6px; background: #fff; color: #0c2a5e; cursor: pointer; }
.osva-korb .add-to-basket-lg-container:hover { background: #0c2a5e; color: #fff; }
.osva-korb .add-to-basket-lg-container i { margin: 0 !important; position: static !important; }
.osva-korb > div > *:not(.add-to-basket-lg-container) { display: none !important; }
@media (max-width: 575.98px) {
  .osva-zb-zeile { grid-template-columns: 52px minmax(0, 1fr) auto 40px; gap: 10px; padding: 7px 8px 7px 10px; }
  .osva-zb-zeile > a.osva-zb-bild img { width: 52px; height: 52px; }
  .osva-korb, .osva-korb .add-to-basket-lg-container { width: 40px; height: 40px; }
}
/* Ceres zeigt den Knopf im Kachel-Baustein nur am Rechner (d-lg-block); in der Zubehörliste immer */
.osva-korb .add-to-basket-lg-container.d-none { display: flex !important; }

/* Empfehlungen: 4 Kacheln nebeneinander, Handy Wischzeile */
.osva-empf { margin: 36px 0 28px; }
.osva-empf h2 { font-size: 26px; color: #0c2a5e; margin-bottom: 18px; }
.osva-reihe { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
.osva-k { position: relative; display: flex; flex-direction: column; background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 1px 3px rgba(12,42,94,.08), 0 4px 14px rgba(12,42,94,.06); text-decoration: none !important; color: #1c1c1c !important; transition: transform .18s, box-shadow .18s; }
.osva-k:hover { transform: translateY(-3px); box-shadow: 0 6px 22px rgba(12,42,94,.16); }
.osva-k-bild { aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center; padding: 14px; background: #fff; }
.osva-k-bild img { max-width: 100%; max-height: 100%; object-fit: contain; }
.osva-k-txt { padding: 12px 14px 14px; border-top: 1px solid #eee; display: flex; flex-direction: column; gap: 4px; flex: 1; }
.osva-k-name { font-size: 15px; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.7em; }
.osva-k-meta { font-size: 12.5px; color: #6b6b6b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-height: 1.4em; }
.osva-k-lief { font-size: 12px; color: #2e7d32; }
.osva-k-preis { margin-top: auto; padding-top: 6px; font-size: 18px; font-weight: 700; color: #0c2a5e; }
.osva-k-preis del { font-size: 13px; font-weight: 400; color: #8a8a8a; margin-left: 6px; }
.osva-marke { position: absolute; top: 10px; left: 10px; z-index: 2; background: #b08052; color: #fff; font-size: 11.5px; font-weight: 700; letter-spacing: .03em; padding: 4px 9px; border-radius: 3px; }
@media (max-width: 991.98px) { .osva-reihe { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } }
@media (max-width: 575.98px) {
  .osva-empf h2 { font-size: 22px; }
  .osva-reihe { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin: 0 -15px; padding: 2px 15px 8px; }
  .osva-reihe::-webkit-scrollbar { display: none; }
  .osva-reihe .osva-k { flex: 0 0 43%; scroll-snap-align: start; }
  .osva-k:hover { transform: none; }
  .osva-k-name { font-size: 14px; }
  .osva-k-txt { padding: 10px 10px 12px; }
  .osva-k-lief { font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .osva-k-preis { font-size: 16px; }
  .osva-marke { top: 6px; left: 6px; font-size: 10px; padding: 3px 6px; }
}
/* Ceres-Artikellisten der Artikelseite weichen, sobald eigene Werte da sind */
body.osva-eigen .widget-item-list { display: none !important; }
{% endif %}
</style>
