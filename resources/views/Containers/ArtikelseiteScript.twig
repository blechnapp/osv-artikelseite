<script>
/* OSVArtikelseite: Zubehör (302) und Empfehlungen (303), Ausführungen mit Namen, Brotkrumen.
 * Kein MutationObserver, kein Vue.component, kein ceresStore (siehe CERES_FRONTEND.md).
 * Variantenwechsel über das Ceres-Ereignis onVariationChanged. */
(function () {
  var C = {{ einstellungJson|raw }};
  var korb = document.querySelector(".widget-add-to-basket");
  if (!korb || !document.querySelector(".widget-item-image")) return;

  function esc(t) { return String(t == null ? "" : t).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }

  // 302/303 lesen wie OSVCustomMeta 288/289: aus den Ceres-Daten der Artikelseite (variationProperties, gruppiert)
  function listenAus(d) {
    var w = {};
    ((d && d.variationProperties) || []).forEach(function (g) {
      (g.properties || []).forEach(function (p) {
        var v = p && p.values && p.values.value;
        if (p && (p.id === 302 || p.id === 303) && typeof v === "string") w[p.id] = v;
      });
    });
    var z = [], e = [];
    String(w[302] || "").split(",").forEach(function (t) { var id = parseInt(t, 10); if (id > 0 && z.indexOf(id) < 0) z.push(id); });
    String(w[303] || "").split(",").forEach(function (t) {
      t = t.trim(); var id = parseInt(t.replace(/^\*/, ""), 10);
      if (id > 0) e.push([id, t.charAt(0) === "*" ? 1 : 0]);
    });
    return { z: z, e: e };
  }
  // Datenblock der gewählten Variante beim Laden (JSON mit total und documents)
  function startDaten() {
    var s = document.querySelectorAll('script[type="application/json"]');
    for (var i = 0; i < s.length; i++) {
      var t = (s[i].textContent || "").trim();
      if (t.indexOf('{"total":') === 0 && t.indexOf('"variationProperties"') > 0) {
        try { var j = JSON.parse(t); return j.documents && j.documents[0] && j.documents[0].data; } catch (x) {}
      }
    }
    return null;
  }
  var start = startDaten();
  var aktuell = start && start.variation ? start.variation.id : 0;
  // Ceres baut die Ausführungs-Kacheln erst nach dem Laden auf; Platz vorher freihalten (Klasse am <html>, außerhalb von Vue)
  if (start && start.attributes && start.attributes.length) document.documentElement.classList.add("osva-ausf");
  if (C.cs && start) {
    var l0 = listenAus(start);
    if (C.ceresAus && (l0.z.length || l0.e.length)) document.documentElement.classList.add("osva-eigen");
    // Platz für die Zubehörliste vorab freihalten (kommt erst nach dem Abruf; schob auf Tablet die Kaufbox nach unten)
    var nz = Math.min(l0.z.length, C.maxZ || 4);
    if (nz) { document.documentElement.style.setProperty("--osva-zb-res", (44 + 81 * nz + 24) + "px"); document.documentElement.classList.add("osva-zb-res"); }
  }

  /* ---------- Ausführungen mit Namen ---------- */
  function namen() {
    if (!C.namen) return;
    var boxen = document.querySelectorAll(".widget-attribute .v-s-boxes.images .v-s-box");
    for (var i = 0; i < boxen.length; i++) {
      var b = boxen[i], img = b.querySelector("img");
      if (!img || b.querySelector(".osva-vname")) continue;
      var s = document.createElement("span");
      s.className = "osva-vname";
      s.textContent = img.getAttribute("alt") || "";
      s.title = s.textContent;
      b.appendChild(s);
    }
  }

  /* ---------- Ausführungen: erst eine Reihe, Rest per Knopf (wie im Entwurf) ---------- */
  // Der Knopf steht außerhalb des Ceres-Bausteins (dahinter im selben Kasten), damit Ceres ihn beim Wechsel nicht entfernt.
  var sicht = null;
  function ausfuehrungenKlappen() {
    if (!C.aufbau) return;
    var w = document.querySelector(".single .widget-sticky .widget-attribute");
    if (!w) return;
    var n = w.querySelectorAll(".v-s-boxes.images .v-s-box").length;
    // Handy: alle Kacheln in der Wischzeile, kein Einklappen (sonst blieben nur 4 sichtbar, Alex 03.11.)
    if (window.matchMedia("(max-width: 575.98px)").matches) {
      w.classList.remove("osva-v-zu", "osva-v-fest");
      var alt = w.parentNode.querySelector(".osva-v-mehr");
      if (alt) alt.parentNode.removeChild(alt);
      sicht = null;
      return;
    }
    var reihe = 5;
    var kn = w.parentNode.querySelector(".osva-v-mehr");
    if (n <= reihe + 1) { w.classList.remove("osva-v-zu"); if (kn) kn.parentNode.removeChild(kn); return; }
    if (!kn) {
      kn = document.createElement("button");
      kn.type = "button";
      kn.className = "osva-v-mehr";
      w.parentNode.insertBefore(kn, w.nextSibling);
      w.classList.add("osva-v-zu");
      kn.addEventListener("click", function () { w.classList.toggle("osva-v-zu"); beschriften(); });
    }
    // Sichtbare Kacheln festhalten: erste Reihe, oder eine weniger plus die gewählte, wenn sie weiter hinten steht.
    // Neu festgelegt wird nur, wenn die gewählte Kachel nicht sichtbar ist. Klickt man eine sichtbare an, bleibt alles stehen.
    // Die Regel steht in einem eigenen Stil-Block, nicht als Klasse an den Kacheln: die setzt Ceres beim Wechsel neu.
    var boxen = [].slice.call(w.querySelectorAll(".v-s-boxes.images .v-s-box"));
    var akt = boxen.indexOf(w.querySelector(".v-s-boxes.images .v-s-box.active"));
    if (!sicht || sicht.reihe !== reihe || sicht.n !== n || (akt >= 0 && sicht.idx.indexOf(akt) < 0)) {
      var idx = [];
      for (var i = 0; i < (akt >= reihe ? reihe - 1 : reihe); i++) idx.push(i);
      if (akt >= reihe) idx.push(akt);
      sicht = { reihe: reihe, n: n, idx: idx };
      var st = document.getElementById("osva-v-stil");
      if (!st) { st = document.createElement("style"); st.id = "osva-v-stil"; document.head.appendChild(st); }
      st.textContent = ".single .widget-sticky .osva-v-zu.osva-v-fest .v-s-boxes.images .v-s-box:not(.active)" +
        idx.map(function (j) { return ":not(:nth-child(" + (j + 1) + " of .v-s-box))"; }).join("") + " { display: none !important; }";
    }
    if (!w.classList.contains("osva-v-fest")) w.classList.add("osva-v-fest");
    function beschriften() {
      var t = w.classList.contains("osva-v-zu") ? "Alle " + n + " Ausführungen zeigen" : "Weniger anzeigen";
      if (kn.textContent !== t) kn.textContent = t;   // nur bei Änderung schreiben, sonst rechnet der Browser alle 0,4 s neu
    }
    beschriften();
  }

  /* ---------- Brotkrumen folgen der Ausführung ---------- */
  function brotkrumen() {
    if (!C.brot) return;
    var h = document.querySelector(".title-outer h1") || document.querySelector(".widget-sticky h1");
    var b = document.querySelector(".breadcrumb .breadcrumb-item.active span");
    if (h && b) {
      var t = (h.textContent || "").replace(/\s+/g, " ").trim();
      if (t) b.textContent = t;
    }
  }

  /* ---------- Abschnitte: Ceres-Reiter werden Klappkarten ---------- */
  // Nur Überschrift einsetzen und Klassen setzen; die Reiter-Leiste bleibt im DOM und wird per CSS versteckt,
  // dadurch rendert Ceres den Reiter-Baustein nicht neu.
  function sterneInKopf(k) {
    if (!k || k.querySelector(".osva-ab-sterne")) return;
    var avg = document.querySelector(".single .widget-sticky .widget-feedback-average");
    var st = avg && avg.querySelector(".feedback-stars-average");
    var anz = avg && avg.querySelector(".small-stars a");
    var n = anz ? (anz.textContent || "").replace(/[^0-9]/g, "") : "";
    if (!st || !n || n === "0") return;
    var sp = document.createElement("span");
    sp.className = "osva-ab-sterne";
    sp.appendChild(st.cloneNode(true));
    sp.appendChild(document.createTextNode("(" + n + ")"));
    k.appendChild(sp);
  }

  // Klick auf die Bewertungszahl oben in der Kaufbox: Bewertungen aufklappen und hinscrollen
  document.addEventListener("click", function (ev) {
    var a = ev.target.closest && ev.target.closest(".single .widget-sticky .widget-feedback-average a");
    if (!a) return;
    var kopf = [].filter.call(document.querySelectorAll(".osva-ab-kopf"), function (k) { return /bewertung/i.test(k.textContent || ""); })[0];
    if (!kopf) return;
    ev.preventDefault();
    var pane = kopf.parentNode;
    if (!pane.classList.contains("osva-offen")) kopf.click();
    pane.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  function abschnitte() {
    if (!C.aufbau) return;
    var tab = document.querySelector(".single .widget-tab");
    if (!tab || tab.classList.contains("osva-karten")) return;
    // Ceres kann den Reiter-Baustein nach dem Laden neu aufbauen; alte Überschriften entfernen, damit nichts doppelt steht
    [].forEach.call(tab.querySelectorAll(".osva-ab-kopf"), function (k) { k.parentNode.removeChild(k); });
    var titel = [].map.call(tab.querySelectorAll(".nav-tabs .nav-link"), function (a) { return (a.textContent || "").trim(); });
    var panes = [].slice.call(tab.querySelectorAll(".tab-content > .tab-pane"));
    if (!panes.length) return;
    function istLeer(p) { return !(p.textContent || "").replace(/\s+/g, "") && !p.querySelector("img, table, iframe"); }
    // Ceres zeigt Reiter ohne Titel nicht in der Leiste, gibt deren Bereich aber aus (gemessen an 966: 6 Bereiche, 5 Titel).
    // Gleiche Zahl: Titel nach Reihenfolge. Sonst: Titel der Reihe nach auf die Bereiche mit Inhalt.
    var mitInhalt = panes.filter(function (p) { return !istLeer(p); });
    var ziele = panes.length === titel.length ? panes : mitInhalt;
    if (ziele.length !== titel.length) return;
    var gross = window.matchMedia("(min-width: 992px)").matches;
    panes.forEach(function (pane) { if (istLeer(pane)) pane.classList.add("osva-leer"); });
    ziele.forEach(function (pane, i) {
      if (pane.classList.contains("osva-leer")) return;
      var k = document.createElement("button");
      k.type = "button";
      k.className = "osva-ab-kopf";
      k.textContent = titel[i];
      pane.insertBefore(k, pane.firstChild);
      // Nur die Beschreibung offen, alles andere zum Aufklappen (Kay 30.10.: Details, Maße, Bewertungen zu)
      var offen = i === 0;
      // Bewertungen: Sterne und Anzahl schon im geschlossenen Kopf zeigen
      // (die Sterne baut Ceres oft erst später; der Takt unten trägt sie nach)
      if (/bewertung/i.test(titel[i])) sterneInKopf(k);
      pane.classList.toggle("osva-offen", offen);
      k.setAttribute("aria-expanded", offen ? "true" : "false");
      k.addEventListener("click", function () {
        var o = pane.classList.toggle("osva-offen");
        k.setAttribute("aria-expanded", o ? "true" : "false");
      });
    });
    // Leere Absätze und Zeilenumbrüche vor dem ersten Inhalt ausblenden (Beschreibungen beginnen oft mit <p>&nbsp;</p>, <br> oder leeren Bausteinen)
    // nur in der Beschreibung: andere Abschnitte (Bewertungen) füllt Ceres erst später, dort darf nichts als leer gelten
    if (ziele[0]) leerAnfang(ziele[0]);
    tab.classList.add("osva-karten");
    var grid = tab.closest(".widget-grid");
    if (grid) grid.classList.add("osva-ab-grid");
  }

  function leer(e) { return !(e.textContent || "").replace(/[\s\u00a0]+/g, "") && !e.querySelector("img, iframe, video, table"); }
  function leerAnfang(pane) {
    var weiter = true;
    (function lauf(el) {
      [].forEach.call(el.children, function (c) {
        if (!weiter || c.classList.contains("osva-ab-kopf")) return;
        var leerbar = /^(P|BR|SPAN|H[1-6])$/.test(c.tagName) || (c.tagName === "DIV" && /\bwidget-(text|inner)\b/.test(c.className));
        if (c.tagName === "BR" || (leerbar && leer(c))) { c.classList.add("osva-weg"); return; }
        if (/^(P|H[1-6]|UL|OL|LI|TABLE|IMG)$/.test(c.tagName) || !c.children.length) { weiter = false; return; }
        lauf(c);
      });
    })(pane);
  }

  /* ---------- Höhe unter dem Namen, Artikeldaten mit Symbolen (Kay 03.11.) ---------- */
  var SVG = {
    haus: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#b08052" stroke-width="2" aria-hidden="true"><path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6"/></svg>',
    lineal: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#b08052" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M3 15.5 15.5 3 21 8.5 8.5 21z"/><path d="M7 12l2 2M10 9l1.5 1.5M13 6l2 2"/></svg>',
    gewicht: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#b08052" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="6" r="2.5"/><path d="M6.5 9h11l2.5 11H4z"/></svg>',
    etikett: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#b08052" stroke-width="2" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>',
    code: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#b08052" stroke-width="2" aria-hidden="true"><path d="M3 5v14M7 5v14M10 5v14M14 5v14M17 5v14M21 5v14"/></svg>',
    herz: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 1 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/></svg>'
  };
  var masse = {};   // Variante -> "10 × 10 × 11 cm" (Eigenschaften 244/245/246, Artikel ohne Verpackung)
  function masseAus(d) {
    var w = {};
    ((d && d.variationProperties) || []).forEach(function (g) {
      (g.properties || []).forEach(function (p) {
        var v = p && p.values && p.values.value;
        if (p && (p.id === 244 || p.id === 245 || p.id === 246 || p.id === 85) && v !== null && v !== undefined && String(v).trim() !== "") w[p.id] = String(v).trim().replace(".", ",");
      });
    });
    return { m: (w[244] && w[245] && w[246]) ? w[244] + " × " + w[245] + " × " + w[246] + " cm" : "", g: w[85] ? w[85] + " g" : "" };
  }
  function hoeheMarkieren() {
    if (!C.aufbau) return;
    var box = document.querySelector(".single .widget-sticky > .widget-inner");
    if (!box) return;
    [].forEach.call(box.children, function (e) {
      if (e.classList.contains("widget-text") && /^Höhe\b/.test((e.textContent || "").trim())) e.classList.add("osva-hoehe");
    });
  }
  var datenStand = "";
  function datenBlock() {
    if (!C.aufbau) return;
    var box = document.querySelector(".single .widget-sticky > .widget-inner");
    var an = box && box.querySelector(":scope > .articlenumber");
    if (!box || !an) return;
    // Ceres schreibt Nummer und „EAN:“ ohne Leerzeichen hintereinander in den Text
    var t = (an.textContent || "").replace(/EAN/g, " EAN").replace(/\s+/g, " ");
    var nr = ((t.match(/Artikelnummer:?\s*(.*?)\s*(?:EAN|$)/) || [])[1] || "").trim();
    var ean = (t.match(/EAN:?\s*(\d+)/) || [])[1] || "";
    var pt = box.querySelector(":scope > .producertag");
    var herst = pt ? (pt.textContent || "").replace(/\s+/g, " ").trim() : "";
    // Hersteller steht im Shop in Großbuchstaben (CSS): Text selbst ist schon richtig geschrieben
    var mg = masse[aktuell] || {}, m = mg.m || "", gw = mg.g || "";
    var stand = [herst, m, gw, nr, ean].join("|");
    var d = document.getElementById("osva-daten");
    if (d && stand === datenStand) return;
    datenStand = stand;
    if (!d) { d = document.createElement("div"); d.id = "osva-daten"; box.appendChild(d); }
    function z(icon, text, wert, klein) { return wert ? '<div class="osva-d-z' + (klein ? " klein" : "") + '">' + SVG[icon] + "<span>" + text + " <b>" + esc(wert) + "</b></span></div>" : ""; }
    d.innerHTML = '<div class="osva-d">' + z("haus", "Hergestellt von", herst) + z("lineal", "Maße (L × B × H)", m) + z("gewicht", "Gewicht", gw) +
      z("etikett", "Artikelnummer", nr, 1) + z("code", "EAN", ean, 1) + "</div>";
  }

  /* ---------- Abmessungen & Gewicht als Tabelle wie „Weitere Details“ (Kay 03.11.) ---------- */
  // Die Absätze („• Abmessungen des Artikels LxBxH: 7 x 7 x 13 cm“) bleiben als Datenquelle im DOM, nur unsichtbar;
  // Ceres tauscht ihre Werte beim Wechsel der Ausführung, die Tabelle wird dann neu gebaut.
  var ABM = [
    [/des Artikels/i, "Artikel (L × B × H)", 1],
    [/Originalverpackung/i, "Originalverpackung (L × B × H)", 2],
    [/Versandverpackung/i, "Versandverpackung (L × B × H)", 3],
    [/^Produktgewicht/i, "Gewicht Artikel", 4],
    [/^Versandgewicht/i, "Gewicht inkl. Versandverpackung", 5]
  ];
  function abmTabelle() {
    if (!C.aufbau) return;
    var k = [].filter.call(document.querySelectorAll(".osva-ab-kopf"), function (x) { return /Abmessung/i.test(x.textContent || ""); })[0];
    if (!k) return;
    [].forEach.call(k.parentNode.querySelectorAll(".widget-text .widget-inner"), function (wi) {
      var ps = [].filter.call(wi.querySelectorAll(":scope > p"), function (q) { return /:/.test(q.textContent || ""); });
      if (!ps.length) return;
      var zeilen = ps.map(function (q, i) {
        var t = (q.textContent || "").replace(/^[\s•·\-]+/, "").replace(/\s+/g, " ").trim();
        var j = t.indexOf(":"), name = t.slice(0, j).trim(), wert = t.slice(j + 1).trim();
        var reg = ABM.filter(function (r) { return r[0].test(name); })[0];
        wert = wert.replace(/\s*x\s*/g, " × ").replace(/(\d)\.(\d)/g, "$1,$2");
        return { n: reg ? reg[1] : name.replace(/\s*LxBxH$/i, " (L × B × H)"), w: wert, o: reg ? reg[2] : 10 + i };
      }).filter(function (z) { return z.w; }).sort(function (a, b) { return a.o - b.o; });
      var stand = zeilen.map(function (z) { return z.n + "=" + z.w; }).join("|");
      var tb = wi.parentNode.querySelector(":scope > .osva-abm");
      if (tb && tb.getAttribute("data-stand") === stand) return;
      ps.forEach(function (q) { q.classList.add("osva-abm-quelle"); });
      if (!tb) { tb = document.createElement("table"); tb.className = "table table-striped table-hover table-sm osva-abm"; wi.parentNode.appendChild(tb); }
      tb.setAttribute("data-stand", stand);
      tb.innerHTML = "<tbody>" + zeilen.map(function (z) { return "<tr><td>" + esc(z.n) + "</td><td>" + esc(z.w) + "</td></tr>"; }).join("") + "</tbody>";
    });
  }

  /* ---------- Chat und Trustami fest in der Seite statt schwebend (Kay 03.11.) ---------- */
  // Chat: Tawk-Blase auf der Artikelseite aus, dafür eine Zeile unter dem Warenkorb, die den Chat öffnet.
  // Trustami: Siegel aus der schwebenden Ecke in die Seite unter die Artikeldaten.
  var chatZeileDa = false;
  function chatZeile() {
    if (!C.aufbau) return;
    var T = window.Tawk_API;
    if (!T || typeof T.hideWidget !== "function") return;
    if (!chatZeileDa) {
      chatZeileDa = true;
      try { T.hideWidget(); } catch (x) {}
      var alt = T.onChatMinimized;
      T.onChatMinimized = function () { try { T.hideWidget(); } catch (x) {} if (typeof alt === "function") alt(); };
    } else if (!(T.isChatMaximized && T.isChatMaximized())) {
      try { if (!T.isChatHidden || !T.isChatHidden()) T.hideWidget(); } catch (x) {}
    }
    var box = document.querySelector(".single .widget-sticky > .widget-inner");
    if (!box || box.querySelector(":scope > .osva-hilfe")) return;
    // Block „Hilfe & Vertrauen“: Chat-Knopf und daneben das Trustami-Siegel
    var hilfe = document.createElement("div");
    hilfe.className = "osva-hilfe";
    box.appendChild(hilfe);
    var b = document.createElement("button");
    b.type = "button"; b.className = "osva-chat";
    b.innerHTML = '<span class="osva-chat-i"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.7A8 8 0 1 1 21 12z"/></svg></span><span class="osva-chat-t">Fragen zum Artikel?<b>Chat öffnen ›</b></span>';
    b.addEventListener("click", function () { try { T.showWidget(); T.maximize(); } catch (x) {} });
    hilfe.appendChild(b);
  }
  function trustamiFest() {
    if (!C.aufbau) return;
    var t = document.querySelector("body > .widget_container_combi_badge, .widget_container_combi_badge:not(.osva-trust-fest)");
    var chat = document.querySelector(".single .widget-sticky > .widget-inner > .osva-hilfe");
    if (!t || !chat || t.classList.contains("osva-trust-fest")) return;
    if (!t.querySelector("iframe")) return;
    t.classList.add("osva-trust-fest");
    [].forEach.call(t.querySelectorAll(".osva-hoch"), function (e) { e.classList.remove("osva-hoch"); });
    chat.appendChild(t);
  }

  // Neue Teile erst einsetzen, wenn Ceres (Vue) die Seite übernommen hat: Eingriffe vorher lassen Vue beim Übernehmen
  // die ganze Seite neu aufbauen (gemessen 03.11.: Seite sprang, CLS 0,33)
  function neuTeile() {
    if (!(window.vueApp && window.vueApp._isMounted)) return;
    hoeheMarkieren(); datenBlock(); herz(); kaufleiste(); wischHinweise(); abmTabelle(); chatZeile(); trustamiFest();
  }

  /* ---------- Handy: Herz im Bild, Kaufleiste, Wischhinweise ---------- */
  function korbKnopfHaupt() { return document.querySelector(".single .widget-sticky .widget-add-to-basket .btn-primary"); }
  function herz() {
    if (!C.aufbau) return;
    var bild = document.querySelector(".single .widget-item-image");
    var wl = document.querySelector(".single .widget-sticky .widget-add-to-wish-list button");
    if (!bild || !wl) return;
    var h = bild.querySelector(".osva-herz");
    if (!h) {
      h = document.createElement("button");
      h.type = "button"; h.className = "osva-herz"; h.setAttribute("aria-label", "Auf die Wunschliste"); h.innerHTML = SVG.herz;
      if (getComputedStyle(bild).position === "static") bild.style.position = "relative";
      bild.appendChild(h);
      h.addEventListener("click", function () {
        var b = document.querySelector(".single .widget-sticky .widget-add-to-wish-list button");
        if (b) b.click();
        setTimeout(herzStand, 600);
      });
    }
    herzStand();
  }
  function herzStand() {
    var h = document.querySelector(".osva-herz");
    var b = document.querySelector(".single .widget-sticky .widget-add-to-wish-list button");
    if (!h || !b) return;
    var an = /entfernen/i.test(b.getAttribute("data-original-title") || b.getAttribute("title") || "");
    h.classList.toggle("an", an);
  }
  var leiste = null;
  function kaufleiste() {
    if (!C.aufbau) return;
    var k = korbKnopfHaupt();
    if (!k) return;
    if (!leiste) {
      leiste = document.createElement("div");
      leiste.className = "osva-leiste weg";
      leiste.innerHTML = '<img alt="" width="44" height="44"><span class="p"></span><button type="button">In den Warenkorb</button>';
      document.body.appendChild(leiste);
      document.body.classList.add("osva-mit-leiste");
      leiste.querySelector("button").addEventListener("click", function () { var kk = korbKnopfHaupt(); if (kk) kk.click(); });
      window.addEventListener("scroll", leisteLage, { passive: true });
    }
    var pr = document.querySelector(".single .widget-sticky .widget-item-price .price");
    var preis = pr ? (pr.textContent || "").replace(/\s+/g, " ").trim() : "";
    var p = leiste.querySelector(".p"), soll = esc(preis) + "<small>inkl. MwSt., zzgl. Versand</small>";
    if (p.innerHTML !== soll) p.innerHTML = soll;
    var im = document.querySelector(".single .widget-item-image .single-carousel img");
    var src = im ? (im.currentSrc || im.src || "") : "";
    var li = leiste.querySelector("img");
    if (src && li.getAttribute("src") !== src) li.setAttribute("src", src);
    leisteLage();
  }
  function leisteLage() {
    var k = korbKnopfHaupt();
    if (!leiste || !k) return;
    var r = k.getBoundingClientRect();
    var sichtbar = r.top < window.innerHeight - 70 && r.bottom > 60;
    if (leiste.classList.contains("weg") === sichtbar && leisteStand !== null) {
      // Chat und Siegel laden teils später nach: gelegentlich nachziehen
      if (leisteStand && Date.now() - siegelZeit > 1500) { siegelZeit = Date.now(); siegelHeben(true); }
      return;
    }
    leisteStand = !sichtbar;
    leiste.classList.toggle("weg", sichtbar);
    siegelHeben(!sichtbar);
  }
  var leisteStand = null, siegelZeit = 0;
  // Tawk lädt seine Blase erst nach einigen Sekunden; sie lag dann kurz über „In den Warenkorb“ (Kay 03.11. live).
  // 60 s lang alle 250 ms nur die Chat-Blase prüfen und sofort anheben, solange die Leiste sichtbar ist.
  var chatTakt = 0, chatUhr = setInterval(function () {
    if (++chatTakt > 240) { clearInterval(chatUhr); return; }
    chatZeile(); trustamiFest();
  }, 250);
  // Chat, Bewertungssiegel, reCAPTCHA und Datenschutz-Knopf sitzen unten fest; solange die Leiste da ist, rücken sie über sie
  function siegelHeben(hoch) {
    if (!window.matchMedia("(max-width: 575.98px)").matches) return;
    // Tawk-Chat setzt Lage und transform inline mit !important (CSS greift nicht): Abstand unten direkt am iframe setzen.
    // Alex 03.11.: Chat-Blase verdeckte „In den Warenkorb“ in der Leiste.
    [].forEach.call(document.querySelectorAll('iframe[title="Chat-Widget"]'), function (f) {
      var st = f.getAttribute("style") || "";
      var m = st.match(/inset:\s*auto\s+(\d+)px\s+(\d+)px\s+auto/);
      if (!m) return;
      if (!f.hasAttribute("data-osva-unten")) f.setAttribute("data-osva-unten", m[2]);
      var soll = hoch ? (parseInt(f.getAttribute("data-osva-unten"), 10) + 78) : parseInt(f.getAttribute("data-osva-unten"), 10);
      if (parseInt(m[2], 10) !== soll) f.style.setProperty("inset", "auto " + m[1] + "px " + soll + "px auto", "important");
    });
    [].forEach.call(document.querySelectorAll("body *"), function (e) {
      if (e === leiste || e.closest(".osva-leiste, .mobile-navigation, .osva-trust-fest") || e.getAttribute("title") === "Chat-Widget") return;
      if (e.classList.contains("osva-hoch")) { if (!hoch) e.classList.remove("osva-hoch"); return; }
      if (!hoch) return;
      var st = getComputedStyle(e);
      if (st.position !== "fixed" || e.offsetHeight < 15 || e.offsetHeight > 200) return;
      if (e.getBoundingClientRect().bottom < window.innerHeight - 160) return;
      e.classList.add("osva-hoch");
    });
  }
  function amEnde(el) { el.classList.toggle("osva-ende", el.scrollLeft + el.clientWidth >= el.scrollWidth - 4); }
  function wischHinweise() {
    if (!C.aufbau) return;
    var vb = document.querySelector(".single .widget-sticky .widget-attribute .v-s-boxes.images");
    if (vb && !vb.getAttribute("data-osva-w")) {
      vb.setAttribute("data-osva-w", "1");
      vb.addEventListener("scroll", function () { amEnde(vb); }, { passive: true });
    }
    if (vb) {
      amEnde(vb);
      var n = vb.querySelectorAll(".v-s-box").length;
      var w = vb.closest(".widget-attribute");
      var kopf = w && w.querySelector('[data-testing="attribute-name"]');
      var ziel = kopf ? kopf.parentNode : null;
      if (ziel && n > 4 && !ziel.querySelector(".osva-anzahl")) {
        // Tipp schaltet zwischen Wischzeile und allen Kacheln (Alex 03.11.: „Alle Ausführungen zeigen“ am Handy nicht anwählbar)
        var a = document.createElement("button");
        a.type = "button"; a.className = "osva-anzahl";
        a.addEventListener("click", function () {
          var ww = document.querySelector(".single .widget-sticky .widget-attribute");
          if (ww) ww.classList.toggle("osva-alle");
          anzahlText();
        });
        ziel.insertBefore(a, ziel.firstChild);
      }
      anzahlText();
    }
  }
  function anzahlText() {
    var a = document.querySelector(".osva-anzahl"), w = document.querySelector(".single .widget-sticky .widget-attribute");
    if (!a || !w) return;
    var n = w.querySelectorAll(".v-s-boxes.images .v-s-box").length;
    var t = w.classList.contains("osva-alle") ? "Weniger anzeigen" : "Alle " + n + " zeigen ›";
    if (a.textContent !== t) a.textContent = t;
  }
  function empfPunkte(box) {
    var rh = box.querySelector(".osva-reihe");
    if (!rh) return;
    var k = rh.querySelectorAll(".osva-k").length;
    if (k < 2) return;
    var pt = document.createElement("div");
    pt.className = "osva-punkte";
    for (var i = 0; i < k; i++) pt.appendChild(document.createElement("i"));
    rh.parentNode.insertBefore(pt, rh.nextSibling);
    function lauf() {
      var a = Math.round(rh.scrollLeft / ((rh.scrollWidth - rh.clientWidth) || 1) * (k - 1));
      [].forEach.call(pt.children, function (e, j) { e.classList.toggle("an", j === a); });
      amEnde(rh);
    }
    rh.addEventListener("scroll", lauf, { passive: true });
    lauf();
  }

  /* ---------- Zubehör und Empfehlungen ---------- */
  var daten = { v: {}, t: {} }, korbVms = [];

  function kachelOk(t) { return t && t.ok && t.hp; }

  function ga(ereignis, liste, eintraege) {
    try {
      var dl = window.dataLayer = window.dataLayer || [];
      dl.push({ ecommerce: null });
      dl.push({ event: ereignis, ecommerce: { item_list_name: liste, items: eintraege.map(function (e, i) {
        return { item_id: e.t.nr, item_name: e.t.n + (e.t.vn ? " " + e.t.vn : ""), price: e.t.pv, index: i, item_list_name: liste };
      }) } });
    } catch (x) {}
  }

  // Warenkorb wie in der Ceres-Kategoriekachel: Ceres' eigener Baustein add-to-basket, an die laufende Ceres-App gehängt (Muster aus OSVSuche 0.12.1)
  function korbKnopf(ziel, id, t) {
    var app = window.vueApp, V = window.Vue || (app && app.constructor);
    if (!app || !app._isMounted || !V) return false;
    var ceres = app.$ceres || {}, cfg = (window.App && App.config && App.config.item) || {};
    // Ceres zeigt statt des Korbs einen Pfeil, wenn Mindest- oder Intervallmenge nicht 1 ist; leer oder 0 heißt in Plenty 1
    var mn = +t.mn > 1 ? +t.mn : 1, iq = +t.iq > 1 ? +t.iq : 1;
    var p = { variationId: +id, isSalable: !!t.ok, hasChildren: false, intervalQuantity: iq, minimumQuantity: mn, maximumQuantity: t.mx,
      orderProperties: t.op || [], hasOrderProperties: !!t.hop, hasRequiredOrderProperty: !!t.hrop, showQuantity: false,
      itemUrl: t.u, hasPrice: !!t.hp, hasGraduatedPrice: t.gpn > 1 && !!cfg.enableGraduatedPrices, itemType: t.it, useLargeScale: true };
    var vm = new V({ parent: app, render: function (h) { return h("add-to-basket", { props: p }); } });
    vm.$mount(ziel);
    korbVms.push(vm);
    return true;
  }

  function aufraeumen() {
    korbVms.forEach(function (vm) { try { vm.$destroy(); } catch (x) {} });
    korbVms = [];
    var alt = document.querySelectorAll(".osva-zb, .osva-empf");
    for (var i = 0; i < alt.length; i++) alt[i].parentNode.removeChild(alt[i]);
  }

  function zubehoerZeigen(liste) {
    var eintraege = [];
    (liste || []).forEach(function (id) {
      var t = daten.t[id];
      if (kachelOk(t) && eintraege.length < C.maxZ) eintraege.push({ id: id, t: t });
    });
    if (!eintraege.length) { document.documentElement.classList.remove("osva-zb-res"); return; }
    var box = document.createElement("div");
    box.className = "osva-zb";
    box.innerHTML = '<div class="osva-zb-kopf">' + esc(C.titelZ) + "</div>" + eintraege.map(function (e) {
      var t = e.t;
      return '<div class="osva-zb-zeile" data-id="' + e.id + '">' +
        '<a class="osva-zb-bild" href="' + esc(t.u) + '"><img src="' + esc(t.b) + '" alt="' + esc(t.alt || t.n) + '" width="64" height="64" loading="lazy"></a>' +
        '<a class="osva-zb-txt" href="' + esc(t.u) + '"><b>' + esc(t.n) + "</b><em>" + esc(t.vn) + "</em></a>" +
        '<span class="osva-zb-preis">' + esc(t.p) + '<sup class="osva-stern">*</sup>' + (t.uvp && t.uvpv > t.pv ? "<del>" + esc(t.uvp) + "</del>" : "") + "</span>" +
        '<span class="osva-korb"><span></span></span></div>';
    }).join("");
    var w = korb.closest(".widget") || korb;
    w.parentNode.insertBefore(box, w.nextSibling);
    document.documentElement.classList.remove("osva-zb-res");
    eintraege.forEach(function (e) {
      var z = box.querySelector('.osva-zb-zeile[data-id="' + e.id + '"] .osva-korb > span');
      if (!z || !korbKnopf(z, e.id, e.t)) {
        var k = box.querySelector('.osva-zb-zeile[data-id="' + e.id + '"] .osva-korb');
        if (k) k.style.display = "none";
      }
    });
    box.addEventListener("click", function (ev) {
      var a = ev.target.closest && ev.target.closest("a");
      if (a) ga("select_item", C.titelZ, eintraege.filter(function (e) { return a.getAttribute("href") === e.t.u; }));
    });
    ga("view_item_list", C.titelZ, eintraege);
  }

  function empfZeigen(liste) {
    var eintraege = [];
    (liste || []).forEach(function (paar) {
      var t = daten.t[paar[0]];
      if (kachelOk(t) && eintraege.length < C.maxE) eintraege.push({ id: paar[0], t: t, stern: paar[1] });
    });
    if (!eintraege.length) return;
    var box = document.createElement("section");
    box.className = "osva-empf";
    box.innerHTML = "<h2>" + esc(C.titelE) + '</h2><div class="osva-reihe">' + eintraege.map(function (e) {
      var t = e.t;
      // ganze Karte klickbar über den Namens-Link (::after über die Karte), Warenkorb-Knopf liegt darüber
      return '<div class="osva-k" data-id="' + e.id + '">' + (e.stern ? '<span class="osva-marke">' + esc(C.marke) + "</span>" : "") +
        '<span class="osva-k-bild"><img src="' + esc(t.b) + '" alt="' + esc(t.alt || t.n) + '" loading="lazy"></span>' +
        '<span class="osva-k-txt"><a class="osva-k-name" href="' + esc(t.u) + '">' + esc(t.n) + '</a><span class="osva-k-meta">' + esc(t.vn) + "</span>" +
        (t.av ? '<span class="osva-k-lief">' + esc(t.av) + "</span>" : "") +
        '<span class="osva-k-fuss"><span class="osva-k-preis">' + esc(t.p) + '<sup class="osva-stern">*</sup>' + (t.uvp && t.uvpv > t.pv ? "<del>" + esc(t.uvp) + "</del>" : "") + "</span>" +
        '<span class="osva-korb"><span></span></span></span>' +
        '<span class="osva-k-mehr">Zum Artikel &rsaquo;</span></span></div>';
    }).join("") + "</div>";
    // an die Stelle der Ceres-Listen, sonst unter die Reiter
    var ziel = document.querySelector(".widget-item-list") || document.querySelector(".widget-feedback") || document.querySelector(".widget-tab");
    if (ziel) {
      ziel = ziel.closest(".widget") || ziel;
      ziel.parentNode.insertBefore(box, ziel);
    } else return;
    eintraege.forEach(function (e) {
      var z = box.querySelector('.osva-k[data-id="' + e.id + '"] .osva-korb > span');
      if (!z || !korbKnopf(z, e.id, e.t)) {
        var k = box.querySelector('.osva-k[data-id="' + e.id + '"] .osva-korb');
        if (k) k.style.display = "none";
      }
    });
    box.addEventListener("click", function (ev) {
      var a = ev.target.closest && ev.target.closest("a.osva-k-name");
      if (a) ga("select_item", C.titelE, eintraege.filter(function (e) { return a.getAttribute("href") === e.t.u; }));
    });
    empfPunkte(box);
    ga("view_item_list", C.titelE, eintraege);
  }

  function listenZeigen(vid) {
    aufraeumen();
    var l = daten.v[vid];
    var eigen = !!(l && (l.z.length || l.e.length));
    // Ceres-Listen nur ausblenden, wenn diese Ausführung eigene Werte hat
    // am <html>, damit es schon vor Vue gilt (Ceres-Listen verschwanden sonst nach dem Laden: Tablet-CLS 0,08–0,1)
    document.documentElement.classList.toggle("osva-eigen", eigen && !!C.ceresAus);
    if (!eigen) { document.documentElement.classList.remove("osva-zb-res"); return; }
    zubehoerZeigen(l.z);
    empfZeigen(l.e);
  }

  // Kacheldaten (Bild, Preis, Warenkorb) für die genannten Varianten holen, nur was noch fehlt
  function zeigen(vid, d) {
    if (!C.cs || !vid) return;
    if (d && !daten.v[vid]) daten.v[vid] = listenAus(d);
    var l = daten.v[vid];
    if (!l) return;
    var fehlt = l.z.concat(l.e.map(function (p) { return p[0]; })).filter(function (id) { return !(id in daten.t); });
    if (!fehlt.length) { if (vid === aktuell) listenZeigen(vid); return; }
    fetch("/rest/osv-artikelseite/listen?t=" + fehlt.sort(function (a, b) { return a - b; }).join(","), { credentials: "same-origin" })
      .then(function (r) { return r.json(); })
      .then(function (j) {
        fehlt.forEach(function (id) { daten.t[id] = (j && j.t && j.t[id]) || null; });
        if (vid === aktuell) listenZeigen(vid);
      })
      .catch(function () {});
  }

  document.addEventListener("onVariationChanged", function (e) {
    var d = e && e.detail && e.detail.documents && e.detail.documents[0] && e.detail.documents[0].data;
    var vid = d && d.variation && d.variation.id;
    setTimeout(function () {
      namen();
      ausfuehrungenKlappen();
      brotkrumen();
      if (vid && d && !(vid in masse)) masse[vid] = masseAus(d);
      if (vid && vid !== aktuell) { aktuell = vid; zeigen(vid, d); }
      neuTeile();
    }, 60);
  });

  // Ceres baut die Ausführungs-Kacheln erst nach diesem Skript auf: kurz nachfassen (ohne MutationObserver)
  namen();
  // Ceres baut Ausführungs-Kacheln und Reiter erst nach diesem Skript auf (im echten Shop gemessen 28.10.): nachfassen
  // Bei manchen Artikeln dauert das länger als 5 s (a-205, a-1067): alle 0,4 s nachsehen, 20 s lang
  var versuche = 0;
  var takt = setInterval(function () {
    versuche++;
    namen(); ausfuehrungenKlappen(); abschnitte();
    neuTeile();
    sterneInKopf([].filter.call(document.querySelectorAll(".osva-ab-kopf"), function (k) { return /bewertung/i.test(k.textContent || ""); })[0]);
    // 20 s lang prüfen, auch wenn die Karten schon stehen: baut Ceres neu auf, werden sie wiederhergestellt
    if (versuche >= 50) clearInterval(takt);
  }, 400);
  abschnitte();
  if (aktuell && start) masse[aktuell] = masseAus(start);
  window.__osvaDaten = daten;
  zeigen(aktuell, start);
})();
</script>
